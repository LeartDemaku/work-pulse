    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "nodemailer": "^6.10.1",
    "sql.js": "^1.13.0"
