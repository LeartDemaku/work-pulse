{
  "name": "punaime-backend",
  "version": "2.0.0",
  "description": "Backend server for Platforma (WorkPulse) job application platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test",
